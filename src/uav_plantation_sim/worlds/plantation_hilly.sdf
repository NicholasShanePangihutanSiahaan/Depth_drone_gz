<?xml version="1.0"?>
<sdf version="1.9">
  <world name="plantation_hilly">
    <physics name="uav_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.36 0.38 0.40 1</ambient>
      <background>0.70 0.82 0.94 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun_key">
      <pose>-10 -10 18 0.35 0.55 -0.75</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.90 0.78 1</diffuse>
      <specular>0.25 0.24 0.20 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.55 0.25 -0.80</direction>
    </light>

    <!-- Flat takeoff/home area and the surrounding plantation floor. -->
    <model name="base_ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
        </collision>
        <visual name="grass_soil">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.24 0.32 0.16 1</ambient>
            <diffuse>0.30 0.42 0.20 1</diffuse>
            <specular>0.04 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A continuous 10% grade: flat home -> gentle climb -> short crest.
         Height rises from 0.0 m at x=1 to 0.4 m at x=5. -->
    <model name="gentle_uphill">
      <static>true</static>
      <pose>3.0 0 0.1403 0 -0.0996687 0</pose>
      <link name="slope">
        <collision name="collision">
          <geometry><box><size>4.020 20.0 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.020 20.0 0.12</size></box></geometry>
          <material><ambient>0.27 0.36 0.18 1</ambient><diffuse>0.34 0.48 0.23 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill_crest">
      <static>true</static>
      <pose>5.75 0 0.20 0 0 0</pose>
      <link name="crest">
        <collision name="collision">
          <geometry><box><size>1.50 20.0 0.40</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.50 20.0 0.40</size></box></geometry>
          <material><ambient>0.28 0.37 0.19 1</ambient><diffuse>0.36 0.49 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Gentle descent from 0.4 m at x=6.5 back to 0.0 m at x=10.5.
         The orbit around the tree crosses this slope and the flat crest. -->
    <model name="gentle_downhill">
      <static>true</static>
      <pose>8.5 0 0.1403 0 0.0996687 0</pose>
      <link name="slope">
        <collision name="collision">
          <geometry><box><size>4.020 20.0 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.020 20.0 0.12</size></box></geometry>
          <material><ambient>0.25 0.34 0.17 1</ambient><diffuse>0.32 0.45 0.21 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- At x=7 the analytical terrain height is approximately 0.35 m. -->
    <include>
      <name>tree_00_00</name>
      <uri>model://oil_palm</uri>
      <pose>7.0 0.0 0.35 0 0 0</pose>
    </include>
  </world>
</sdf>
