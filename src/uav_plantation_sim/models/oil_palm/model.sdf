<?xml version="1.0"?>
<sdf version="1.9">
  <model name="oil_palm">
    <static>true</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Collision: Tetap pakai silinder sederhana agar komputasi physics Gazebo tidak berat saat UAV terbang di sekitarnya.
           Ukuran disesuaikan dengan batang mesh yang sebenarnya: 0 .. 3.29 m -->
      <collision name="collision">
        <pose>0 0 1.64 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.45</radius><length>3.28</length></cylinder>
        </geometry>
      </collision>

      <!-- Visual: Memanggil model 3D realistis Anda.
           Mesh aslinya Y-up dan pusatnya jauh dari origin, jadi:
             roll +90 deg  -> sumbu Y mesh jadi Z dunia (pohon berdiri tegak)
             scale 1.8     -> tinggi total 3.466 * 1.8 = 6.24 m (sama dengan model prosedural lama)
             offset x/y/z  -> batang di origin, pangkal batang tepat di tanah (z = 0) -->
      <visual name="visual_mesh">
        <pose>0.011 -8.753 3.196 1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://oil_palm/Tropical_Oil_Palm_tree.obj</uri>
            <scale>1.8 1.8 1.8</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- Target Inflorescence: marker koordinat referensi, dipindah ke posisi tandan buah asli
           pada mesh (material xx-001nklb / palm695x300.jpg) yang berada di z = 2.78 .. 3.72 m -->
      <visual name="inflorescence_target">
        <pose>0.45 0 3.25 0 0 0</pose>
        <geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><ambient>0.65 0.45 0.08 1</ambient><diffuse>0.95 0.67 0.16 1</diffuse><specular>0.08 0.05 0.02 1</specular></material>
      </visual>

    </link>
  </model>
</sdf>
