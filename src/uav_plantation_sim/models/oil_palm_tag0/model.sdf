<?xml version="1.0"?>
<sdf version="1.9">
  <model name="oil_palm_tag0">
    <static>true</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Collision: Tetap pakai silinder sederhana agar komputasi physics Gazebo tidak berat saat UAV terbang di sekitarnya.
           Ukuran mengikuti batang mesh: 0 .. 3.28 m -->
      <collision name="collision">
        <pose>0 0 1.64 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.45</radius><length>3.28</length></cylinder>
        </geometry>
      </collision>

      <!-- Visual: mesh realistis yang sama dengan oil_palm (scale 1.8).
           roll +90 deg  -> sumbu Y mesh jadi Z dunia (pohon berdiri tegak)
           offset x/y/z  -> batang di origin, pangkal batang tepat di tanah (z = 0) -->
      <visual name="visual_mesh">
        <pose>0.011 -8.753 3.196 1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://oil_palm/Tropical_Oil_Palm_tree.obj</uri>
            <scale>1.8 1.8 1.8</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- AprilTag: menempel di permukaan batang mesh.
           Radius batang pada z = 1.35 .. 1.50 m adalah ~0.42 m, jadi tag diletakkan di x = 0.46
           supaya sedikit menonjol dan tidak z-fighting dengan mesh. -->
      <visual name="apriltag0">
        <pose>0.46 0 1.35 0 0 0</pose>
        <geometry>
          <box><size>0.02 0.25 0.25</size></box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/tag25h9-0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Target Inflorescence: marker koordinat referensi pada posisi tandan buah asli
           di mesh (material xx-001nklb / palm695x300.jpg), z = 2.78 .. 3.72 m -->
      <visual name="inflorescence_target">
        <pose>0.45 0 3.25 0 0 0</pose>
        <geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><ambient>0.65 0.45 0.08 1</ambient><diffuse>0.95 0.67 0.16 1</diffuse><specular>0.08 0.05 0.02 1</specular></material>
      </visual>

    </link>
  </model>
</sdf>
