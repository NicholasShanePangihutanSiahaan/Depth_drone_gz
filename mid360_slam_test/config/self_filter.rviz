Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: livox_frame
    Background Color: 25; 25; 25
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Axes
      Name: Native LiDAR axes
      Enabled: true
      Reference Frame: <Fixed Frame>
      Length: 0.5
      Radius: 0.01
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw returns (toggle to compare)
      Enabled: false
      Topic:
        Value: /lidar_test/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 170; 170; 170
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Filtered for SLAM (green)
      Enabled: true
      Topic:
        Value: /slam_test/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 0; 255; 100
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Inside sphere (red)
      Enabled: true
      Topic:
        Value: /slam_test/self_removed_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 50; 50
      Style: Points
      Size (Pixels): 4
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Measured body sphere
      Enabled: true
      Topic:
        Value: /slam_test/body_sphere_marker
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2
      Pitch: 0.4
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 800
